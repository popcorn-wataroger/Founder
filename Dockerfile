# Founder を Cloud Run で動かすためのコンテナ定義。
#
# このファイルの役割:
#     「アプリを動かすのに必要なもの一式（Python本体・依存パッケージ・アプリのコード）を
#     1つの箱に詰める手順書」。docker build がこの手順を上から順に実行してイメージを作り、
#     Cloud Run はそのイメージを起動するだけでアプリが動く状態になる。
#
# 機密情報をここに書かない:
#     APIキーや署名鍵はイメージに焼き込まず、Cloud Run が起動時に環境変数として
#     注入する（Secret Manager からのマウント）。イメージは誰が取得しても
#     鍵が出てこない状態に保つ。詳細は docs/secrets.md を参照。
#
# 2段構成にしている理由（マルチステージビルド）:
#     依存パッケージを入れる作業には uv が要るが、アプリを動かすだけなら要らない。
#     1段で作ると uv（約50MB）が完成品に残り続ける。
#     前半（builder）で仮想環境を作り、後半で「できあがった仮想環境だけ」を
#     持ち込めば、道具は完成品に入らない。
#     前後で同じベースイメージを使うのが条件（仮想環境の中身が Python 本体を
#     絶対パスで指しているため、Python の場所が変わると動かなくなる）。

# ==========================================================
# 前半: 依存パッケージを入れる（この段は完成品に残らない）
# ==========================================================
# slim 版を使う理由: 通常の python:3.11 は約1GBあり、その大半はビルドツールなど
# 実行時に使わないもの。slim にすると起動（コンテナの取得）が速くなる。
# タグを 3.11-slim ではなく 3.11-slim-bookworm と固定しているのは、
# Debian のバージョンが将来勝手に上がってビルド結果が変わらないようにするため。
FROM python:3.11-slim-bookworm AS builder

# 依存パッケージの管理に使う uv を、公式イメージから実行ファイルだけ取り出して置く。
# pip install uv より速く、バージョンも固定できる。
# バージョンを :latest にしないのは、ビルドするたびに uv が変わると
# 「昨日は通ったのに今日は落ちる」が起きるため。
COPY --from=ghcr.io/astral-sh/uv:0.11.9 /uv /usr/local/bin/uv

# UV_COMPILE_BYTECODE=1
#     インストール時に .pyc（Pythonが読む中間形式）を作っておく。
#     起動のたびにコンパイルする手間が消え、Cloud Run のコールドスタート
#     （新しいインスタンスが立ち上がる時間）が短くなる。
# UV_LINK_MODE=copy
#     uv がキャッシュからハードリンクではなくコピーで配置する。
#     Docker のレイヤーをまたぐとハードリンクが張れず警告が出るため。
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

WORKDIR /app

# アプリのコードより先に、依存の定義ファイルだけをコピーしてインストールする。
#
# なぜ順番を分けるか:
#     Docker は命令ごとに結果をキャッシュし、変化が無ければ再実行しない。
#     コード全体を先にコピーすると、app/main.py を1行直しただけでも
#     「コピー以降」が全部やり直しになり、依存のインストールも毎回走る。
#     依存の定義（pyproject.toml / uv.lock）は滅多に変わらないので、
#     先に済ませておけばコード修正時のビルドが数秒で終わる。
COPY pyproject.toml uv.lock ./

# --frozen             … uv.lock のとおりに入れる。lock を勝手に更新させない
#                        （ローカルとイメージで依存のバージョンをずらさないため）
# --no-dev             … 開発用の依存（pytest / ruff / mypy /
#                        google-cloud-secret-manager）を入れない。
#                        本番は Cloud Run が環境変数として値を注入するので、
#                        アプリ自身が Secret Manager を読むことはない
# --no-install-project … このリポジトリ自身をパッケージとして入れない
#                        （pyproject.toml で package = false としているため）
RUN uv sync --frozen --no-dev --no-install-project

# ==========================================================
# 後半: 実際に動かすイメージ
# ==========================================================
FROM python:3.11-slim-bookworm

# PYTHONUNBUFFERED=1
#     ログを溜め込まず即座に出力する。これが無いとバッファに溜まったまま
#     コンテナが終了し、Cloud Logging に肝心のエラーが出ないことがある。
# PYTHONDONTWRITEBYTECODE=1
#     実行時に .pyc を書き出さない。前半で作成済みのうえ、コンテナは使い捨てなので
#     書いても次回に残らず、ファイルシステムを汚すだけ。
# PATH
#     仮想環境の実行ファイルへパスを通す。これで `uvicorn` と書くだけで
#     /app/.venv/bin/uvicorn が使われる（毎回 `uv run` を挟まなくてよくなる）。
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/app/.venv/bin:$PATH"

# 実行ユーザーを先に作る。
#
# root のまま動かさない理由:
#     もしアプリに侵入されても、コンテナ内でシステムファイルを
#     書き換えられる範囲を狭められる。
# --create-home を付ける理由:
#     ライブラリがホームディレクトリに一時ファイルを作ろうとしたときに失敗しないため。
#
# ファイルを置く前にユーザーを作っておくのは、あとで chown -R しないため。
# chown はファイルの情報を書き換える操作なので、Docker は変更後のファイルを
# レイヤーに丸ごと作り直す。仮想環境（約470MB）に対して実行すると
# イメージが265MB増える（実測値）。COPY --chown で置くときに所有者を決めれば増えない。
RUN useradd --create-home --uid 1000 appuser

WORKDIR /app

# 前半で作った仮想環境だけを持ち込む（uv 本体は持ち込まない）
COPY --from=builder --chown=appuser:appuser /app/.venv /app/.venv

# アプリ本体。
# ここで入るもの: app/ · static/ · data/users.csv · pyproject.toml · uv.lock
# .env や .venv は .dockerignore で除外済み（何が入るかはそちらを参照）。
COPY --chown=appuser:appuser . .

USER appuser

# EXPOSE は「このコンテナはこのポートで待つ」という記録用の宣言。
# 実際に何番で待つかは下の CMD が決める。
EXPOSE 8080

# Cloud Run は待ち受けポートを環境変数 PORT で渡してくる（既定は 8080）。
# ポートを固定で書くと、Cloud Run 側が別の番号を渡したときに
# 「起動はしたが誰も繋がらない」状態になるため、必ず PORT を読む。
# ${PORT:-8080} は「PORT があればそれを、無ければ 8080 を使う」という意味で、
# ローカルで docker run するときは PORT を渡さなくても動く。
#
# --host 0.0.0.0 が必須な理由:
#     既定の 127.0.0.1 はコンテナ内部からの接続しか受け付けない。
#     外（Cloud Run のルーターやホストPC）から届かず、必ず接続できない。
#
# --reload を付けない理由:
#     ファイル変更の監視は開発用の機能で、本番では余計なCPUとメモリを使う。
#     イメージの中身は起動後に変わらないので、監視する意味もない。
#
# シェル経由（sh -c）で起動しているのは、${PORT} を展開するため。
# CMD ["uvicorn", "--port", "${PORT}"] のように書くと環境変数が展開されず、
# 文字列 "${PORT}" がそのままポート番号として渡って起動に失敗する。
CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8080}"]
