# このファイルについて
#
# 機密情報の「正解」は Google Secret Manager にあります。
# ローカル開発は `uv run python scripts/dev.py` で起動すると、
# スクリプトが起動前に Secret Manager から取得して環境変数に入れるため、
# 通常このファイルをコピーして .env を作る必要はありません。
#
# .env が必要になるのは、dev.py を通さずに起動する場合（オフライン時など）だけです。
# その場合は下の「Secret Manager 管理対象」に自分で値を書く必要があります。
# 詳細は docs/secrets.md を参照してください。

# ==========================================================
# Secret Manager 管理対象（この4つ。通常は空のままでよい）
# ==========================================================
# dev.py を通さずに起動する場合のみ、手で値を入れる。
# 値は Secret Manager のコンソールで確認する（チャットやIssueに貼らない）。

# ログイントークンの署名鍵。
# APP_ENV が local / test のときだけ、空でも開発用の既定値で起動する。
# 本番相当（APP_ENV が local / test 以外、未設定を含む）では未設定だと起動しない。
JWT_SECRET_KEY=

# Gemini API の認証キー。空だとAIの回答生成が失敗する。
GEMINI_API_KEY=

# Qdrant（ベクトルDB）の接続先と認証キー。空だとソース検索が失敗する。
QDRANT_URL=
QDRANT_API_KEY=

# ==========================================================
# アプリの動作設定（機密ではない）
# ==========================================================

# 実行環境の識別子。local / test 以外は本番相当として扱う（未設定も本番相当）。
# scripts/dev.py は起動時に APP_ENV=local を自分で設定するので、
# dev.py を使う限りこの値は参照されない。dev.py を通さずに起動する場合は必須。
APP_ENV=local

# ==========================================================
# 現在どのコードからも読まれていない設定
# ==========================================================
# 将来使う予定があるため名前だけ残している。
# 値を入れても現在の挙動は変わらない。

# デバッグ表示の切り替え用（未使用）
APP_DEBUG=true

# Qdrant のコレクション名（未使用）。
# 現在のコレクション名は app/vector_store.py に定数で書かれている。
QDRANT_COLLECTION=

# GCSバケット名（未使用）。Issue #64 で使う予定。
GCS_BUCKET_NAME=

# Cloud SQL の接続情報（未使用）。Issue #65 で使う予定。
DATABASE_URL=

# ==========================================================
# GCP の認証情報（GCS / Secret Manager が共通で使う）
# ==========================================================
# ADC（gcloud auth application-default login）を使う前提なので、通常は空のままでよい。
#   gcloud auth application-default login
# 空にしておくと SDK が ADC の既定の場所を自動で探す。
# サービスアカウントのキーファイルを使う場合だけ、その JSON の絶対パスを入れる。
# 値を入れるときは、実在するファイルのパスにすること。
# 存在しないパスが入っていると SDK はそちらを優先して読みにいき、認証に失敗する。
GOOGLE_APPLICATION_CREDENTIALS=
