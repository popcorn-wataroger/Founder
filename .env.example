# このファイルについて
#
# 機密情報の「正解」は Google Secret Manager にあります。
# ローカル開発は `uv run python scripts/dev.py` で起動すると、
# スクリプトが起動前に Secret Manager から取得して環境変数に入れるため、
# 通常このファイルをコピーして .env を作る必要はありません。
# DB への接続情報（DATABASE_URL）も dev.py が取得します。
# テストは `uv run python scripts/test.py` で実行すると、同じ仕組みで用意されます。
#
# .env が必要になるのは、dev.py / test.py を通さずに起動する場合（オフライン時など）だけです。
# その場合は下の「Secret Manager 管理対象」に自分で値を書く必要があります。
# 詳細は docs/secrets.md を参照してください。

# ==========================================================
# Secret Manager 管理対象（この4つと、下の DATABASE_URL。通常は空のままでよい）
# ==========================================================
# dev.py / test.py を通さずに起動する場合のみ、手で値を入れる。
# 値は Secret Manager のコンソールで確認する（チャットやIssueに貼らない）。

# ログイントークンの署名鍵。
# APP_ENV が local / test のときだけ、空でも開発用の既定値で起動する。
# 本番相当（APP_ENV が local / test 以外、未設定を含む）では未設定だと起動しない。
JWT_SECRET_KEY=

# Gemini API の認証キー。空だとAIの回答生成が失敗する。
GEMINI_API_KEY=

# Qdrant（ベクトルDB）の接続先と認証キー。空だとソース検索が失敗する。
QDRANT_URL=
QDRANT_API_KEY=

# ==========================================================
# アプリの動作設定（機密ではない）
# ==========================================================

# 実行環境の識別子。local / test 以外は本番相当として扱う（未設定も本番相当）。
# scripts/dev.py は起動時に APP_ENV=local を自分で設定するので、
# dev.py を使う限りこの値は参照されない。dev.py を通さずに起動する場合は必須。
APP_ENV=local

# アップロードしたファイルの保存先バケット名（Issue #64）。
# バケット名は機密ではないため Secret Manager の管理対象には入れていない。
# 空のままなら、ローカルの uploads/ に保存する（APP_ENV が local / test のときだけ）。
# 本番相当の環境で未設定なら起動しない（コンテナの中に保存すると停止時に消えるため）。
GCS_BUCKET_NAME=

# Cloud SQL(PostgreSQL) への接続URL（Issue #65）。
# app/database.py はこの値だけを見て接続先を決める（コードに環境ごとの分岐を持たせない）。
# 空のままDBを使う画面を開くと RuntimeError で止まる。
#
# 接続先によって形が変わる。実際のユーザー名・パスワードはここに書かないこと。
#   ローカル   … 別ターミナルで cloud-sql-proxy を起動してから、その待ち受け先を指す
#                postgresql://founder:<PASSWORD>@localhost:5432/founder
#   テスト     … 末尾をテスト用DBにする（本番用の founder を指すとテストのTRUNCATEで消える）
#                postgresql://founder:<PASSWORD>@localhost:5432/founder_test
#   Cloud Run … Unix ソケット経由。ホスト名に /cloudsql/<接続名> を指定する
#                postgresql://founder:<PASSWORD>@/founder?host=/cloudsql/<接続名>
#
# Secret Manager に登録済み（Issue #66 のCloud Runデプロイ時に登録。バージョン1が有効）。
# 登録されている値は Cloud Run 用のUnixソケット形式で、本番では環境変数としてマウントされる。
#
# ローカルでは scripts/dev.py がこの値を取得し、to_local_database_url() で
# proxy 経由（localhost:5432）の形に変換してから環境変数に入れる（Issue #82）。
# テストでは scripts/test.py が、さらにデータベース名を founder_test に差し替える。
# そのため dev.py / test.py を使う限り、ここに値を書く必要はない。
# 手で入れるのは、dev.py / test.py を通さずに起動する場合だけ。
DATABASE_URL=

# ==========================================================
# 現在どのコードからも読まれていない設定
# ==========================================================
# 将来使う予定があるため名前だけ残している。
# 値を入れても現在の挙動は変わらない。

# デバッグ表示の切り替え用（未使用）
APP_DEBUG=true

# Qdrant のコレクション名（未使用）。
# 現在のコレクション名は app/vector_store.py に定数で書かれている。
QDRANT_COLLECTION=

# ==========================================================
# GCP の認証情報（GCS / Secret Manager が共通で使う）
# ==========================================================
# ADC（gcloud auth application-default login）を使う前提なので、通常は空のままでよい。
#   gcloud auth application-default login
# 空にしておくと SDK が ADC の既定の場所を自動で探す。
# サービスアカウントのキーファイルを使う場合だけ、その JSON の絶対パスを入れる。
# 値を入れるときは、実在するファイルのパスにすること。
# 存在しないパスが入っていると SDK はそちらを優先して読みにいき、認証に失敗する。
# Cloud Run ではサービスアカウントが自動で使われるため、設定不要。
GOOGLE_APPLICATION_CREDENTIALS=
