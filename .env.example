# Gemini
GEMINI_API_KEY=

# App
# APP_ENV は local / test 以外を本番相当として扱う。未設定も本番相当。
APP_ENV=local
APP_DEBUG=true

# JWT
# ログイントークンの署名鍵。ローカルは空でも起動する（開発用の既定値が使われる）。
# 本番では必須（未設定なら起動しない）。値は Secret Manager で管理する。
# ローカル用の値を作る場合: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=founder_sources

# Google Cloud Storage
GCS_BUCKET_NAME=

# GCP の認証情報（GCS / Secret Manager が共通で使う）。
# ADC（gcloud auth application-default login）を使う前提なので、通常は空のままでよい。
#   gcloud auth application-default login
# 空にしておくと SDK が ADC の既定の場所を自動で探す。
# サービスアカウントのキーファイルを使う場合だけ、その JSON の絶対パスを入れる。
# 値を入れるときは、実在するファイルのパスにすること。
# 存在しないパスが入っていると SDK はそちらを優先して読みにいき、認証に失敗する。
GOOGLE_APPLICATION_CREDENTIALS=

# Database
DATABASE_URL=
