# Gemini
GEMINI_API_KEY=

# App
# APP_ENV は local / test 以外を本番相当として扱う。未設定も本番相当。
APP_ENV=local
APP_DEBUG=true

# JWT
# ログイントークンの署名鍵。ローカルは空でも起動する（開発用の既定値が使われる）。
# 本番では必須（未設定なら起動しない）。値は Secret Manager で管理する。
# ローカル用の値を作る場合: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=founder_sources

# Google Cloud Storage
# アップロードしたファイルの保存先バケット名。
# 空のままなら、ローカルの uploads/ に保存する（APP_ENV が local / test のときだけ）。
# 本番相当の環境で未設定なら起動しない（コンテナの中に保存すると停止時に消えるため）。
GCS_BUCKET_NAME=
# サービスアカウントキー(JSON)のファイルパス。SDKがこの環境変数を自分で読む。
# ローカルでは `gcloud auth application-default login` を実行すれば空のままでよい。
# Cloud Run ではサービスアカウントが自動で使われるため、設定不要。
GOOGLE_APPLICATION_CREDENTIALS=

# Database
DATABASE_URL=
